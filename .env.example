# Copy to .env locally; never commit the filled file.
CPP_DOMAIN=game.example.com
DJANGO_SECRET_KEY=
DJANGO_DB_PATH=/data/game.sqlite3
DJANGO_SECURE_HSTS_SECONDS=3600
CPP_IMAGE_TAG=local

# Loopback spare ports are the safe local defaults.
# On the verified Azure host, use 0.0.0.0, 80 and 443 for public HTTPS.
CPP_BIND_ADDRESS=127.0.0.1
CPP_HTTP_PORT=8080
CPP_HTTPS_PORT=8443
CPP_BACKEND_MEMORY=512m
CPP_BACKEND_CPUS=1.0
