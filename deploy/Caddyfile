{
	admin off
	auto_https disable_redirects
	skip_install_trust
}

http://{$CPP_DOMAIN} {
	redir https://{$CPP_DOMAIN}:{$CPP_HTTPS_PORT:443}{uri} 308
}

https://{$CPP_DOMAIN} {
	header {
		Strict-Transport-Security "max-age={$DJANGO_SECURE_HSTS_SECONDS:3600}"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
	}

	@backend path /ws/* /health/*
	handle @backend {
		reverse_proxy backend:8000
	}

	handle /admin* {
		respond 404
	}

	handle {
		root * /srv
		header Cache-Control no-cache
		try_files {path} /index.html
		file_server
	}
}
